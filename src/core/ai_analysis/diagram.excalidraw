    {
      "id": "u9C17fcO0VgVPOJpZPgNJ",
      "type": "text",
      "x": -717.7642676618852,
      "y": 895.6221283636758,
      "width": 666.8995361328125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 1990205015,
      "version": 588,
      "versionNonce": 726270455,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762896949732,
      "link": null,
      "locked": false,
      "text": "1. Определение URL\n2. Определение логики обработки запроса\n3. Определение базовых агентов (оркестратора, datasets и charts)\n4. Реализация агента прогноза\n5. Учет истории построения графиков и прогноза\n5. Реализация препроцессинга (когда получу файл)\n6. Реализация сохранения истории сообщений",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Определение URL\n2. Определение логики обработки запроса\n3. Определение базовых агентов (оркестратора, datasets и charts)\n4. Реализация агента прогноза\n5. Учет истории построения графиков и прогноза\n5. Реализация препроцессинга (когда получу файл)\n6. Реализация сохранения истории сообщений",
      "autoResize": true,
      "lineHeight": 1.25
    }
